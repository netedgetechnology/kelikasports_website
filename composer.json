{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "kelika/website-cms",
  "type": "project",
  "description": "KELIKA dynamic sports academy website and section-based CMS",
  "keywords": ["laravel", "cms", "sports", "kelika"],
  "license": "proprietary",
  "require": {
    "php": ">=8.3",
    "laravel/framework": "^13.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
    "post-create-project-cmd": ["@php artisan key:generate --ansi"],
    "test": "@php artisan test"
  },
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true, "allow-plugins": {"php-http/discovery": true}},
  "minimum-stability": "stable",
  "prefer-stable": true
}
