/* KELIKA final hero: clean editorial layout, no diagonal overlays */
.hero-redesign {
    --hf-cream: #fffaf1;
    --hf-white: #fffdf9;
    --hf-green: #075447;
    --hf-terracotta: #d96e50;
    --hf-gold: #d9a652;
    --hf-ink: #173f38;

    position: relative !important;
    display: block !important;
    width: 100% !important;
    height: calc(100vh - 78px) !important;
    height: calc(100svh - 78px) !important;
    min-height: 520px !important;
    max-height: 760px !important;
    padding: 0 !important;
    overflow: hidden !important;
    background: var(--hf-cream) !important;
    color: var(--hf-ink) !important;
    isolation: isolate;
}

.hero-redesign > .container-fluid {
    position: relative !important;
    width: 100% !important;
    max-width: none !important;
    height: 100% !important;
    padding: 0 !important;
    margin: 0 !important;
}

.hero-redesign .row {
    display: grid !important;
    grid-template-columns: minmax(0, 44%) minmax(0, 56%) !important;
    width: 100% !important;
    height: 100% !important;
    min-height: 0 !important;
    margin: 0 !important;
    align-items: stretch !important;
}

.hero-redesign .hero-copy {
    grid-column: 1 !important;
    grid-row: 1 !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    align-items: flex-start !important;
    position: relative !important;
    z-index: 2 !important;
    width: 100% !important;
    max-width: none !important;
    min-width: 0 !important;
    height: 100% !important;
    padding: 34px clamp(22px, 3vw, 48px) 112px clamp(28px, 5vw, 78px) !important;
    background: var(--hf-white) !important;
}

.hero-redesign .eyebrow {
    margin: 0 0 clamp(14px, 2.1vh, 24px) !important;
    color: #697771 !important;
    font-size: 10px !important;
    line-height: 1.6 !important;
    font-weight: 800 !important;
    letter-spacing: .18em !important;
}

.hero-redesign .display-title {
    margin: 0 !important;
    color: var(--hf-green) !important;
    font-size: clamp(45px, 5.1vw, 78px) !important;
    line-height: .91 !important;
    font-weight: 900 !important;
    letter-spacing: -.06em !important;
}

.hero-redesign .display-title span {
    display: block !important;
    width: auto !important;
    white-space: nowrap !important;
}

.hero-redesign .display-title span:nth-child(1) {
    color: var(--hf-green) !important;
}
.hero-redesign .display-title span:nth-child(2) {
    color: var(--hf-terracotta) !important;
}
.hero-redesign .display-title span:nth-child(3) {
    color: var(--hf-gold) !important;
}

.hero-redesign .hero-copy .lead {
    max-width: 440px !important;
    margin: clamp(16px, 2.2vh, 24px) 0 !important;
    color: #626d67 !important;
    font-size: clamp(13px, 1.05vw, 15px) !important;
    line-height: 1.7 !important;
}

.hero-redesign .hero-actions {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 10px !important;
}

.hero-redesign .hero-actions .btn {
    min-height: 44px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 9px !important;
    padding: 11px 17px !important;
    font-size: 10px !important;
    font-weight: 800 !important;
    letter-spacing: .06em !important;
}

.hero-redesign .hero-actions .btn-kelika {
    background: var(--hf-green) !important;
    border-color: var(--hf-green) !important;
    color: #fff !important;
}
.hero-redesign .hero-actions .btn-kelika-outline {
    background: transparent !important;
    border: 1px solid var(--hf-green) !important;
    color: var(--hf-green) !important;
}

.hero-redesign .hero-visual {
    grid-column: 2 !important;
    grid-row: 1 !important;
    position: relative !important;
    width: 100% !important;
    max-width: none !important;
    min-width: 0 !important;
    height: 100% !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
    background: #eee0c7 !important;
}

.hero-redesign .hero-visual picture {
    position: absolute !important;
    inset: 0 !important;
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    z-index: 1 !important;
}

.hero-redesign .hero-visual .hero-image {
    position: absolute !important;
    inset: 0 !important;
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    min-height: 0 !important;
    max-height: none !important;
    object-fit: cover !important;
    object-position: center 35% !important;
    clip-path: none !important;
    margin: 0 !important;
}

/* Solid champagne panel: deliberate, reliable geometry without diagonal masks. */
.hero-redesign .hero-visual::before {
    content: none !important;
    display: none !important;
}

.hero-redesign .hero-visual::after {
    content: "" !important;
    display: block !important;
    position: absolute !important;
    inset: 0 0 0 auto !important;
    width: 22% !important;
    height: 100% !important;
    background: #f1dfbf !important;
    clip-path: none !important;
    z-index: 2 !important;
    pointer-events: none !important;
}

.hero-redesign .hero-side-message {
    position: absolute !important;
    top: 50% !important;
    right: 0 !important;
    bottom: auto !important;
    width: 22% !important;
    height: auto !important;
    padding: 16px 10px !important;
    margin: 0 !important;
    transform: translateY(-50%) !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    text-align: center !important;
    color: var(--hf-green) !important;
    z-index: 3 !important;
}

.hero-redesign .hero-side-message > span {
    display: block !important;
    width: 100% !important;
    margin: 0 !important;
    color: #8d543d !important;
    font-family: Georgia, "Times New Roman", serif !important;
    font-size: clamp(22px, 2.4vw, 38px) !important;
    font-style: italic !important;
    font-weight: 700 !important;
    line-height: 1.12 !important;
    letter-spacing: -.045em !important;
}

.hero-redesign .hero-side-values {
    margin-top: 22px !important;
    color: #425d50 !important;
    font-size: 9px !important;
    font-weight: 900 !important;
    line-height: 2.4 !important;
    letter-spacing: .14em !important;
}

.hero-redesign .hero-side-message > i {
    display: block !important;
    width: 30px !important;
    height: 2px !important;
    margin-top: 18px !important;
    background: #b78b55 !important;
}

.hero-redesign .hero-features {
    position: absolute !important;
    left: clamp(28px, 5vw, 78px) !important;
    bottom: 22px !important;
    z-index: 4 !important;
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    width: min(42%, 490px) !important;
    max-width: 490px !important;
    margin: 0 !important;
    padding: 0 !important;
    gap: 13px 14px !important;
    background: transparent !important;
    transform: none !important;
}

.hero-redesign .hero-feature {
    display: flex !important;
    align-items: center !important;
    gap: 9px !important;
    min-width: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    color: #40554c !important;
    font-size: 10px !important;
    font-weight: 700 !important;
    line-height: 1.35 !important;
}

.hero-redesign .hero-feature svg {
    display: block !important;
    flex: 0 0 25px !important;
    width: 25px !important;
    height: 25px !important;
    fill: none !important;
    stroke: #b47c45 !important;
    stroke-width: 1.5 !important;
}

@media (min-width: 992px) and (max-height: 700px) {
    .hero-redesign {
        height: calc(100svh - 78px) !important;
        min-height: 480px !important;
    }
    .hero-redesign .hero-copy {
        padding-bottom: 100px !important;
    }
    .hero-redesign .display-title {
        font-size: clamp(44px, 4.2vw, 64px) !important;
    }
    .hero-redesign .hero-features {
        gap: 9px 10px !important;
        bottom: 14px !important;
    }
    .hero-redesign .hero-feature {
        font-size: 9px !important;
    }
}

@media (max-width: 991.98px) {
    .hero-redesign {
        height: auto !important;
        min-height: 0 !important;
        max-height: none !important;
        overflow: hidden !important;
    }
    .hero-redesign > .container-fluid {
        height: auto !important;
    }
    .hero-redesign .row {
        display: flex !important;
        flex-direction: column !important;
        height: auto !important;
    }
    .hero-redesign .hero-copy {
        order: 1 !important;
        height: auto !important;
        padding: 38px 28px 28px !important;
    }
    .hero-redesign .display-title {
        font-size: clamp(44px, 8.5vw, 68px) !important;
    }
    .hero-redesign .hero-copy .lead {
        max-width: 560px !important;
    }
    .hero-redesign .hero-visual {
        order: 2 !important;
        height: clamp(340px, 60vw, 480px) !important;
        min-height: 340px !important;
    }
    .hero-redesign .hero-visual::after {
        width: 24% !important;
    }
    .hero-redesign .hero-side-message {
        width: 24% !important;
    }
    .hero-redesign .hero-side-message > span {
        font-size: clamp(20px, 4vw, 30px) !important;
    }
    .hero-redesign .hero-side-values {
        margin-top: 16px !important;
        font-size: 8px !important;
        line-height: 2.2 !important;
    }
    .hero-redesign .hero-features {
        position: relative !important;
        left: auto !important;
        bottom: auto !important;
        order: 3 !important;
        width: 100% !important;
        max-width: none !important;
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        padding: 22px 28px 26px !important;
        background: var(--hf-white) !important;
    }
}

@media (max-width: 575.98px) {
    .hero-redesign .hero-copy {
        padding: 32px 22px 26px !important;
    }
    .hero-redesign .eyebrow {
        font-size: 9px !important;
        letter-spacing: .13em !important;
    }
    .hero-redesign .display-title {
        font-size: clamp(42px, 11.5vw, 58px) !important;
    }
    .hero-redesign .hero-actions {
        gap: 8px !important;
    }
    .hero-redesign .hero-actions .btn {
        padding: 10px 12px !important;
        font-size: 9px !important;
    }
    .hero-redesign .hero-visual {
        height: 340px !important;
        min-height: 340px !important;
    }
    .hero-redesign .hero-visual::after,
    .hero-redesign .hero-side-message {
        width: 27% !important;
    }
    .hero-redesign .hero-side-message {
        padding: 10px 4px !important;
    }
    .hero-redesign .hero-side-message > span {
        font-size: clamp(17px, 5.3vw, 23px) !important;
    }
    .hero-redesign .hero-side-values {
        margin-top: 13px !important;
        font-size: 7px !important;
        letter-spacing: .08em !important;
    }
    .hero-redesign .hero-features {
        padding: 18px 20px 22px !important;
        gap: 14px 8px !important;
    }
    .hero-redesign .hero-feature {
        font-size: 9px !important;
        gap: 6px !important;
    }
    .hero-redesign .hero-feature svg {
        flex-basis: 22px !important;
        width: 22px !important;
        height: 22px !important;
    }
}
