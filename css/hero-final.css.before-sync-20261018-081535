/* KELIKA reference hero — independent CMS image and decorative framing */
.hero-redesign {
    --kh-cream: #fffaf1;
    --kh-green: #075447;
    --kh-coral: #df7052;
    --kh-gold: #dfa94f;
    --kh-champagne: #f4e1bf;

    position: relative !important;
    isolation: isolate !important;
    display: block !important;
    width: 100% !important;
    height: calc(100vh - 82px) !important;
    height: calc(100svh - 82px) !important;
    min-height: 680px !important;
    max-height: 900px !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
    background: var(--kh-cream) !important;
    color: var(--kh-green) !important;
}

.hero-redesign > .container-fluid {
    position: relative !important;
    width: 100% !important;
    max-width: none !important;
    height: 100% !important;
    padding: 0 !important;
    margin: 0 !important;
}

.hero-redesign .row {
    position: relative !important;
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    margin: 0 !important;
}

/* Central photograph: independent of text and side panel. */
.hero-redesign .hero-visual {
    position: absolute !important;
    z-index: 1 !important;
    top: 0 !important;
    bottom: 0 !important;
    left: 33.5% !important;
    right: 17.5% !important;
    width: auto !important;
    height: 100% !important;
    min-height: 0 !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
    background: #123e36 !important;
    clip-path: polygon(0 0, 84% 0, 100% 100%, 23% 100%) !important;
}

.hero-redesign .hero-visual picture,
.hero-redesign .hero-visual .hero-image {
    position: absolute !important;
    inset: 0 !important;
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    min-height: 0 !important;
    max-height: none !important;
    margin: 0 !important;
    object-fit: cover !important;
    object-position: center center !important;
}

/* Geometric accents stay separate from the CMS photograph. */
.hero-redesign .hero-visual::before {
    content: "" !important;
    position: absolute !important;
    z-index: 3 !important;
    inset: 0 auto auto 0 !important;
    width: 30% !important;
    height: 58% !important;
    background: #075447 !important;
    clip-path: polygon(0 0, 100% 0, 30% 100%, 0 75%) !important;
    opacity: .72 !important;
    pointer-events: none !important;
}

.hero-redesign .hero-visual::after {
    content: "" !important;
    position: absolute !important;
    z-index: 4 !important;
    inset: 0 0 0 auto !important;
    width: 13% !important;
    background: var(--kh-coral) !important;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%, 42% 52%) !important;
    pointer-events: none !important;
}

/* Left text panel. */
.hero-redesign .hero-copy {
    position: relative !important;
    z-index: 5 !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    align-items: flex-start !important;
    width: 46% !important;
    max-width: 760px !important;
    min-width: 0 !important;
    height: 87% !important;
    padding: 25px 20px 20px clamp(36px, 5.4vw, 94px) !important;
    background: transparent !important;
}

.hero-redesign .eyebrow {
    margin: 0 0 22px !important;
    color: #627e75 !important;
    font-size: clamp(10px, .82vw, 14px) !important;
    font-weight: 800 !important;
    letter-spacing: .20em !important;
    line-height: 1.5 !important;
    text-transform: uppercase !important;
}

.hero-redesign .display-title {
    margin: 0 0 15px !important;
    color: var(--kh-green) !important;
    font-size: clamp(54px, 6.4vw, 112px) !important;
    font-weight: 900 !important;
    letter-spacing: -.055em !important;
    line-height: .84 !important;
    text-transform: uppercase !important;
}

.hero-redesign .display-title span {
    display: block !important;
    white-space: nowrap !important;
}

.hero-redesign .display-title span:nth-child(1) {
    color: var(--kh-green) !important;
}

.hero-redesign .display-title span:nth-child(2) {
    color: var(--kh-coral) !important;
}

.hero-redesign .display-title span:nth-child(3) {
    color: var(--kh-gold) !important;
}

.hero-redesign .hero-copy .lead {
    max-width: 520px !important;
    margin: 0 0 24px !important;
    color: #6b8985 !important;
    font-size: clamp(15px, 1.22vw, 22px) !important;
    line-height: 1.5 !important;
}

.hero-redesign .hero-actions {
    display: flex !important;
    flex-wrap: wrap !important;
    align-items: center !important;
    gap: 18px !important;
    margin: 0 !important;
}

.hero-redesign .hero-actions .btn {
    display: inline-flex !important;
    min-height: 64px !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 0 30px !important;
    border-radius: 3px !important;
    font-size: 14px !important;
    font-weight: 800 !important;
    letter-spacing: .07em !important;
    text-transform: uppercase !important;
    text-decoration: none !important;
    white-space: nowrap !important;
    box-shadow: none !important;
}

.hero-redesign .hero-actions .btn-kelika {
    border: 1px solid var(--kh-green) !important;
    background: var(--kh-green) !important;
    color: #fff !important;
}

.hero-redesign .hero-actions .btn-kelika-outline {
    border: 1px solid #0a7767 !important;
    background: rgba(255,250,241,.96) !important;
    color: var(--kh-green) !important;
}

/* Three-colour accent under the calls to action. */
.hero-redesign .hero-copy::after {
    content: "" !important;
    display: block !important;
    width: 168px !important;
    height: 6px !important;
    margin-top: 28px !important;
    background: linear-gradient(
        90deg,
        var(--kh-green) 0 34%,
        var(--kh-coral) 34% 66%,
        var(--kh-gold) 66% 100%
    ) !important;
}

/* Right champagne panel. */
.hero-redesign .hero-side-message {
    position: absolute !important;
    z-index: 6 !important;
    top: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    width: 17.5% !important;
    min-width: 210px !important;
    padding: 32px 20px !important;
    background: var(--kh-champagne) !important;
    color: var(--kh-green) !important;
    text-align: center !important;
}

.hero-redesign .hero-side-message h2,
.hero-redesign .hero-side-message .side-title {
    max-width: 100% !important;
    margin: 0 0 24px !important;
    color: var(--kh-green) !important;
    font-family: "Brush Script MT", "Segoe Script", cursive !important;
    font-size: clamp(32px, 3.1vw, 56px) !important;
    font-weight: 700 !important;
    font-style: italic !important;
    line-height: .98 !important;
}

.hero-redesign .hero-side-message::before {
    content: "" !important;
    display: block !important;
    width: 76px !important;
    height: 3px !important;
    margin: 0 0 24px !important;
    background: var(--kh-gold) !important;
}

/* Keep feature row above the hero background, not in normal-flow overflow. */
.hero-redesign .hero-features {
    position: absolute !important;
    z-index: 7 !important;
    left: 0 !important;
    bottom: 0 !important;
    display: flex !important;
    align-items: center !important;
    width: 58% !important;
    min-height: 126px !important;
    margin: 0 !important;
    padding: 18px 24px 18px clamp(36px, 5.4vw, 94px) !important;
    background: rgba(255,250,241,.96) !important;
}

/* Prevent legacy hero rules from adding extra margins or transforms. */
.hero-redesign .hero-visual *,
.hero-redesign .hero-copy *,
.hero-redesign .hero-side-message *,
.hero-redesign .hero-features * {
    transform: none;
}

@media (max-width: 1200px) and (min-width: 992px) {
    .hero-redesign .hero-copy {
        width: 49% !important;
        padding-left: 4vw !important;
    }

    .hero-redesign .display-title {
        font-size: clamp(52px, 6vw, 78px) !important;
    }

    .hero-redesign .hero-actions {
        gap: 10px !important;
    }

    .hero-redesign .hero-actions .btn {
        min-height: 54px !important;
        padding: 0 17px !important;
        font-size: 12px !important;
    }

    .hero-redesign .hero-side-message {
        min-width: 185px !important;
        padding-inline: 12px !important;
    }
}

/* Mobile/tablet: stack content rather than compressing desktop geometry. */
@media (max-width: 991.98px) {
    .hero-redesign {
        height: auto !important;
        min-height: 0 !important;
        max-height: none !important;
        overflow: visible !important;
        padding: 0 !important;
    }

    .hero-redesign > .container-fluid,
    .hero-redesign .row {
        height: auto !important;
    }

    .hero-redesign .hero-copy {
        width: 100% !important;
        height: auto !important;
        min-height: 0 !important;
        padding: 42px 24px 32px !important;
    }

    .hero-redesign .display-title {
        font-size: clamp(52px, 12vw, 82px) !important;
    }

    .hero-redesign .hero-copy .lead {
        font-size: 16px !important;
    }

    .hero-redesign .hero-actions .btn {
        min-height: 52px !important;
        padding: 0 18px !important;
        font-size: 11px !important;
    }

    .hero-redesign .hero-visual {
        position: relative !important;
        left: auto !important;
        right: auto !important;
        top: auto !important;
        bottom: auto !important;
        width: 100% !important;
        height: clamp(300px, 68vw, 520px) !important;
        min-height: 0 !important;
        clip-path: none !important;
    }

    .hero-redesign .hero-visual::before {
        width: 20% !important;
        height: 35% !important;
    }

    .hero-redesign .hero-visual::after {
        width: 8% !important;
    }

    .hero-redesign .hero-side-message {
        position: relative !important;
        inset: auto !important;
        width: 100% !important;
        min-width: 0 !important;
        padding: 32px 20px !important;
    }

    .hero-redesign .hero-side-message h2,
    .hero-redesign .hero-side-message .side-title {
        font-size: 38px !important;
    }

    .hero-redesign .hero-features {
        position: relative !important;
        inset: auto !important;
        width: 100% !important;
        min-height: 0 !important;
        padding: 22px 24px !important;
        flex-wrap: wrap !important;
    }
}
