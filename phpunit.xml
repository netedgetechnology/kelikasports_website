<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd" bootstrap="tests/bootstrap.php" colors="true">
    <testsuites><testsuite name="Application"><directory>tests/Feature</directory></testsuite></testsuites>
    <source><include><directory>app</directory></include></source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/><env name="APP_DEBUG" value="true"/><env name="HASH_ROUNDS" value="4"/><env name="CACHE_STORE" value="array"/><env name="SESSION_DRIVER" value="array"/><env name="MAIL_MAILER" value="array"/>
        <!-- Tests run against a throwaway in-memory SQLite database, never the MariaDB database in .env.
             force="true" overrides .env and the shell; tests/TestCase.php refuses to run if this is not in effect. -->
        <env name="DB_CONNECTION" value="sqlite" force="true"/><env name="DB_DATABASE" value=":memory:" force="true"/><env name="DB_URL" value="" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <!-- Blade templates compile into a per-run temporary folder (tests/bootstrap.php), never storage/framework/views. -->
        <!-- Reported exceptions in tests must not be written to the development storage/logs/laravel.log. -->
        <env name="LOG_CHANNEL" value="null" force="true"/>
        <!-- Laravel reads $_SERVER before $_ENV, and exported shell variables land in $_SERVER, so force these there too. -->
        <server name="APP_ENV" value="testing" force="true"/><server name="DB_CONNECTION" value="sqlite" force="true"/><server name="DB_DATABASE" value=":memory:" force="true"/><server name="DB_URL" value="" force="true"/><server name="LOG_CHANNEL" value="null" force="true"/>
    </php>
</phpunit>
