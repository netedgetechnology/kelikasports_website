@media(max-width:991.98px){.hero-section{min-height:unset}.hero-copy{padding:3rem 0 2rem}.hero-section picture{display:block;height:100%}.hero-section .hero-image.image-placeholder{display:flex;align-items:center;justify-content:center}.hero-section .hero-image{min-height:300px;clip-path:none;margin-left:0;width:100%}.site-header .nav-link.active{border-bottom:0}.admin-sidebar{min-height:unset}.admin-main{padding:1rem}.display-title{font-size:clamp(2.2rem,10vw,3.6rem)}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}}
.sport-editorial{border-color:var(--kelika-line)!important}.sport-editorial-image{width:100%;min-height:300px;aspect-ratio:1.25;object-fit:cover;border-radius:8px}.sport-number{font-size:clamp(2.4rem,5vw,4rem);font-weight:850;line-height:.9;letter-spacing:-.06em;color:#f3ece2}.sport-features{background:#f8f6f0;padding:1.25rem;border-radius:8px}.sport-features .feature-icon{width:38px;height:38px;background:#fff}
.items-editor[hidden]{display:none!important}.items-editor:not(.js-ready) #section-items-list{display:none}.section-item-editor-card{border:1px solid var(--kelika-line);border-radius:8px;background:#fff;padding:1rem;margin-bottom:1rem}.section-item-editor-card .form-label{font-size:.82rem;font-weight:700;width:100%}.items-json-fallback{border-top:1px solid var(--kelika-line);padding-top:1rem}.items-editor.js-ready+.items-json-fallback{display:none}
#content-data-editor[hidden]{display:none!important}#content-data-editor.js-ready+.content-json-fallback{display:none}.content-json-fallback{border-top:1px solid var(--kelika-line);padding-top:1rem}
.featured-event{overflow:hidden;border-radius:8px;background:var(--kelika-green);color:#fff}.featured-event-copy{padding:clamp(1.5rem,3vw,2.5rem);display:flex;flex-direction:column;align-items:flex-start;justify-content:center}.featured-event-image{width:100%;height:100%;min-height:260px;object-fit:cover;display:block}.event-card-image{width:100%;height:190px;object-fit:cover;display:block}.event-card .card-body{padding:1.25rem}
.cta-section{overflow:hidden}.cta-image{width:100%;height:100%;min-height:220px;max-height:360px;display:block;object-fit:cover;border-radius:8px}.cta-section picture{display:block;height:100%}.cta-section .btn-kelika-outline{border-color:currentColor;color:inherit}.cta-section .btn-kelika-outline:hover{background:rgba(255,255,255,.12)}
