*{box-sizing:border-box}html{scroll-behavior:smooth}body{font-family:var(--kelika-font),ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--kelika-ink);background:var(--kelika-paper);line-height:1.55}a{color:var(--kelika-green)}a:hover{color:var(--kelika-terracotta)}img{max-width:100%;height:auto}.site-header{position:sticky;top:0;z-index:1000;background:rgba(255,253,249,.96);backdrop-filter:blur(12px);border-bottom:1px solid rgba(232,229,222,.8)}.site-header .navbar-brand{letter-spacing:.24em;font-weight:500;color:#111;font-size:1.55rem}.site-search-input{max-width:120px;border-radius:3px}.site-header .nav-link{font-size:.88rem;color:#273431;padding:.8rem .7rem!important}.site-header .nav-link.active{color:var(--kelika-green);font-weight:700;border-bottom:2px solid var(--kelika-green)}.btn-kelika{--bs-btn-color:#fff;--bs-btn-bg:var(--kelika-green);--bs-btn-border-color:var(--kelika-green);--bs-btn-hover-color:#fff;--bs-btn-hover-bg:var(--kelika-green-deep);--bs-btn-hover-border-color:var(--kelika-green-deep);border-radius:var(--kelika-button-radius,3px);padding:.8rem 1.25rem;font-size:.78rem;font-weight:800;letter-spacing:.045em;text-transform:uppercase}.btn-kelika-outline{color:var(--kelika-green);border:1px solid var(--kelika-green);border-radius:var(--kelika-button-radius,3px);padding:.8rem 1.25rem;font-size:.78rem;font-weight:800;letter-spacing:.045em;text-transform:uppercase}.eyebrow{font-size:.72rem;letter-spacing:.25em;text-transform:uppercase;font-weight:800;color:var(--kelika-green);margin-bottom:.75rem}.display-title{font-size:clamp(2.25rem,5vw,4.6rem);line-height:.99;font-weight:850;letter-spacing:-.055em}.accent-terracotta{color:var(--kelika-terracotta)}.accent-gold{color:var(--kelika-gold)}.section-pad{padding:clamp(2.25rem,3.8vw,4rem) 0}.section-title{font-size:clamp(1.8rem,3.5vw,3.1rem);font-weight:820;line-height:1.05;letter-spacing:-.04em}.hero-section{position:relative;overflow:hidden;background:linear-gradient(105deg,#fffdf9 0%,#fffdf9 46%,#edf2ed 100%);min-height:430px;display:flex;align-items:center}.hero-section picture{display:block;height:100%}.hero-section .hero-image.image-placeholder{display:flex;align-items:center;justify-content:center}.hero-section .hero-image{min-height:390px;height:100%;width:100%;display:block;object-fit:cover;object-position:center;background:linear-gradient(135deg,#e6eee8,#c6d8ce)}.hero-copy{padding:4rem 0}.section-kicker{font-size:.68rem;letter-spacing:.28em;text-transform:uppercase;font-weight:800;color:#7b817d}.soft-card{border:1px solid var(--kelika-line);border-radius:var(--kelika-radius);background:#fff;box-shadow:var(--kelika-shadow);overflow:hidden;height:100%}.soft-card .card-body{padding:1.25rem}.image-placeholder{min-height:180px;background:linear-gradient(135deg,#e8eee8,#c7d9d1);display:flex;align-items:center;justify-content:center;color:var(--kelika-green);font-size:.8rem;letter-spacing:.1em;text-transform:uppercase;font-weight:800}.feature-icon{width:46px;height:46px;border:1px solid var(--kelika-line);border-radius:50%;display:grid;place-items:center;color:var(--kelika-terracotta);font-size:1.2rem}.stat-band{background:var(--kelika-green);color:white}.stat-number{font-size:clamp(2rem,4vw,3rem);font-weight:850;line-height:1}.site-footer{background:#fff;padding:3.5rem 0 1.25rem;border-top:1px solid var(--kelika-line)}.footer-heading{font-size:.74rem;font-weight:850;letter-spacing:.1em;text-transform:uppercase;margin-bottom:1rem}.footer-link{display:block;text-decoration:none;color:#4e5a56;font-size:.9rem;margin:.45rem 0}.footer-bottom{border-top:1px solid var(--kelika-line);margin-top:2rem;padding-top:1rem;color:#737c78;font-size:.78rem}.admin-shell{min-height:100vh;background:#f5f7f5}.admin-sidebar{background:#073f36;color:white;min-height:100vh;padding:1.4rem 1rem}.admin-sidebar a{color:#e9f1ee;text-decoration:none;display:block;padding:.65rem .8rem;border-radius:6px;font-size:.9rem}.admin-sidebar a:hover,.admin-sidebar a.active{background:rgba(255,255,255,.13)}.admin-brand{letter-spacing:.2em;font-size:1.3rem;font-weight:600;padding:.5rem .8rem 1.5rem}.admin-main{padding:2rem;min-width:0}.admin-panel{background:#fff;border:1px solid #e4e9e5;border-radius:10px;padding:1.25rem;box-shadow:0 4px 20px rgba(20,40,30,.035)}.form-label{font-weight:700;font-size:.88rem}.form-control,.form-select{border-color:#d6ddd8;border-radius:5px;padding:.7rem .8rem}.table>:not(caption)>*>*{padding:.85rem .75rem}.status-pill{display:inline-block;border-radius:999px;padding:.2rem .6rem;font-size:.72rem;font-weight:800;background:#edf4ef;color:#205f47}.status-pill.draft{background:#fff2dd;color:#8a5b12}.section-editor{border:1px solid #dfe6e1;border-radius:9px;background:white;padding:1rem;margin-bottom:1rem}.section-editor-header{display:flex;align-items:center;justify-content:space-between;gap:1rem}.section-editor textarea{min-height:100px}.page-hero-small{padding:5rem 0 3rem;background:linear-gradient(110deg,#fffdf9,#edf2ed)}.page-content{min-height:40vh}.ornament{position:absolute;pointer-events:none;opacity:.45;right:-5rem;top:5rem;width:18rem;height:18rem;border:1px solid #d9b17b;border-radius:50%;box-shadow:0 0 0 12px rgba(217,177,123,.08),0 0 0 28px rgba(217,177,123,.06)}.contact-form-card{background:#fff;border:1px solid var(--kelika-line);border-radius:10px;padding:clamp(1.25rem,3vw,2.5rem)}.faq-row{border-bottom:1px solid var(--kelika-line);padding:1rem 0}.cms-notice{font-size:.85rem;background:#f6f1e8;border-left:3px solid var(--kelika-gold);padding:.8rem 1rem}.empty-state{padding:2.5rem;text-align:center;border:1px dashed #cbd5ce;border-radius:10px;color:var(--kelika-muted)}
