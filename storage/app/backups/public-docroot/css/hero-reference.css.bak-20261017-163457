/* KELIKA homepage hero — dedicated layout */
.hero-reference {
    display: block !important;
    height: auto !important;
    min-height: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
    background: #fffdf9 !important;
    color: #172522;
}

.hero-reference > .container-fluid {
    width: 100% !important;
    max-width: none !important;
    padding: 0 0 0 clamp(28px, 3.7vw, 64px) !important;
}

.hero-reference .row {
    display: grid !important;
    grid-template-columns: minmax(0, 42%) minmax(0, 58%) !important;
    grid-template-rows: minmax(590px, auto) !important;
    height: auto !important;
    min-height: 590px !important;
    max-height: none !important;
    margin: 0 !important;
    align-items: stretch !important;
}

.hero-reference .hero-copy,
.hero-reference .hero-visual {
    width: auto !important;
    max-width: none !important;
    min-width: 0 !important;
    margin: 0 !important;
    float: none !important;
}

.hero-reference .hero-copy {
    grid-column: 1 !important;
    grid-row: 1 !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: flex-start !important;
    height: 100% !important;
    padding: 48px 18px 28px 0 !important;
    position: relative !important;
    z-index: 4 !important;
}

.hero-reference .eyebrow {
    margin: 0 0 20px !important;
    font-size: 10px !important;
    line-height: 1.6 !important;
    letter-spacing: .24em !important;
}

.hero-reference .display-title {
    margin: 0 !important;
    font-size: clamp(50px, 4.55vw, 76px) !important;
    line-height: .91 !important;
    letter-spacing: -.055em !important;
    font-weight: 900 !important;
}

.hero-reference .display-title span {
    display: block !important;
    width: auto !important;
    max-width: 100% !important;
}

.hero-reference .display-title .accent-terracotta {
    color: #cf6d50 !important;
}

.hero-reference .display-title .accent-gold {
    color: #d4a35d !important;
}

.hero-reference .lead {
    max-width: 410px !important;
    margin: 20px 0 22px !important;
    font-size: 15px !important;
    line-height: 1.6 !important;
}

.hero-reference .hero-actions {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 12px !important;
}

.hero-reference .hero-actions .btn {
    min-height: 50px !important;
    padding: 13px 20px !important;
    font-size: 10px !important;
}

.hero-reference .hero-features {
    display: grid !important;
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    gap: 0 !important;
    width: calc(100% + 65px) !important;
    margin: auto 0 0 !important;
    padding-top: 22px !important;
    position: relative !important;
    z-index: 5 !important;
}

.hero-reference .hero-feature {
    display: flex !important;
    align-items: center !important;
    gap: 7px !important;
    min-width: 0 !important;
    padding: 0 7px !important;
    font-size: 9px !important;
    line-height: 1.35 !important;
}

.hero-reference .hero-feature:first-child {
    padding-left: 0 !important;
}

.hero-reference .hero-feature:last-child {
    border-right: 0 !important;
}

.hero-reference .hero-feature svg {
    flex: 0 0 27px !important;
    width: 27px !important;
    height: 27px !important;
}

.hero-reference .hero-visual {
    grid-column: 2 !important;
    grid-row: 1 !important;
    position: relative !important;
    height: 100% !important;
    min-height: 0 !important;
    overflow: hidden !important;
}

.hero-reference .hero-visual picture {
    display: block !important;
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    margin: 0 !important;
    overflow: hidden !important;
}

.hero-reference .hero-visual .hero-image {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    min-height: 0 !important;
    max-height: none !important;
    object-fit: cover !important;
    object-position: center 25% !important;
    clip-path: polygon(14% 0, 100% 0, 100% 100%, 0 100%) !important;
}

.hero-reference .hero-visual::after {
    content: "" !important;
    position: absolute !important;
    z-index: 1 !important;
    inset: 0 0 0 auto !important;
    width: 24% !important;
    background: #fffaf1 !important;
    clip-path: polygon(28% 0, 100% 0, 100% 100%, 0 100%) !important;
    pointer-events: none !important;
}

.hero-reference .hero-side-message {
    position: absolute !important;
    z-index: 2 !important;
    top: 50% !important;
    right: 0 !important;
    width: 22% !important;
    transform: translateY(-50%) !important;
    text-align: center !important;
}

.hero-reference .hero-side-message > span {
    display: block !important;
    font-size: clamp(25px, 2.5vw, 40px) !important;
    line-height: .98 !important;
}

.hero-reference .hero-side-values {
    margin-top: 34px !important;
}

@media (min-width: 992px) and (max-width: 1199.98px) {
    .hero-reference .display-title {
        font-size: clamp(48px, 4.5vw, 62px) !important;
    }

    .hero-reference .hero-feature {
        gap: 4px !important;
        padding-right: 4px !important;
        padding-left: 4px !important;
        font-size: 8px !important;
    }

    .hero-reference .hero-feature svg {
        flex-basis: 22px !important;
        width: 22px !important;
        height: 22px !important;
    }
}

@media (max-width: 991.98px) {
    .hero-reference > .container-fluid {
        padding: 0 24px !important;
    }

    .hero-reference .row {
        display: flex !important;
        flex-direction: column !important;
        height: auto !important;
        min-height: 0 !important;
        grid-template-columns: none !important;
        grid-template-rows: none !important;
    }

    .hero-reference .hero-copy {
        display: flex !important;
        width: 100% !important;
        height: auto !important;
        padding: 42px 0 28px !important;
    }

    .hero-reference .display-title {
        font-size: clamp(52px, 9vw, 78px) !important;
    }

    .hero-reference .hero-features {
        width: 100% !important;
        margin: 28px 0 0 !important;
        padding-top: 0 !important;
    }

    .hero-reference .hero-visual {
        flex: 0 0 auto !important;
        width: calc(100% + 48px) !important;
        height: clamp(340px, 60vw, 480px) !important;
        min-height: 0 !important;
        margin: 0 -24px !important;
    }
}

@media (max-width: 575.98px) {
    .hero-reference .hero-copy {
        padding-top: 34px !important;
    }

    .hero-reference .display-title {
        font-size: clamp(46px, 13vw, 66px) !important;
    }

    .hero-reference .hero-features {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        row-gap: 16px !important;
    }

    .hero-reference .hero-feature {
        border-right: 0 !important;
        font-size: 10px !important;
    }

    .hero-reference .hero-visual {
        height: 320px !important;
    }

    .hero-reference .hero-side-message > span {
        font-size: 23px !important;
    }

    .hero-reference .hero-side-values {
        margin-top: 22px !important;
        font-size: 8px !important;
    }
}

/* Reference geometry: layered diagonals and controlled overlap */
@media (min-width: 992px) {
    .hero-reference .hero-visual {
        isolation: isolate !important;
        overflow: hidden !important;
    }

    /* Photograph remains the base layer */
    .hero-reference .hero-visual picture {
        z-index: 0 !important;
    }

    /* Broad light diagonal band at the image's left edge */
    .hero-reference .hero-visual::before {
        content: "" !important;
        display: block !important;
        position: absolute !important;
        z-index: 2 !important;
        pointer-events: none !important;
        top: 0 !important;
        bottom: 0 !important;
        left: 0 !important;
        width: 35% !important;
        background: #fffdf9 !important;
        clip-path: polygon(45% 0, 64% 0, 19% 100%, 0 100%) !important;
    }

    /* Keep the cream side panel above the image and diagonal band */
    .hero-reference .hero-visual::after {
        z-index: 3 !important;
        width: 24% !important;
        clip-path: polygon(28% 0, 100% 0, 100% 100%, 0 100%) !important;
    }

    .hero-reference .hero-side-message {
        z-index: 4 !important;
    }

    /* Bring the feature strip toward the image boundary */
    .hero-reference .hero-features {
        width: calc(100% + 105px) !important;
        position: relative !important;
        z-index: 5 !important;
    }

    .hero-reference .hero-feature {
        position: relative !important;
    }
}

/* Refine diagonal bands to match the light reference treatment */
@media (min-width: 992px) {
    .hero-reference .hero-visual::before {
        left: -2% !important;
        width: 42% !important;
        background: #fffdf9 !important;
        clip-path: polygon(48% 0, 68% 0, 20% 100%, 0 100%) !important;
        z-index: 2 !important;
    }

    .hero-reference .hero-visual picture {
        z-index: 1 !important;
    }

    .hero-reference .hero-visual .hero-image {
        clip-path: polygon(24% 0, 100% 0, 100% 100%, 12% 100%) !important;
        object-position: center 25% !important;
    }

    .hero-reference .hero-visual::after {
        width: 24% !important;
        background: #fffaf1 !important;
        clip-path: polygon(28% 0, 100% 0, 100% 100%, 0 100%) !important;
        z-index: 3 !important;
    }

    .hero-reference .hero-side-message {
        z-index: 4 !important;
    }
}

/* Reference-inspired three-layer diagonal treatment */
@media (min-width: 992px) {
    .hero-reference .hero-visual {
        overflow: hidden !important;
        isolation: isolate !important;
    }

    .hero-reference .hero-visual picture {
        z-index: 1 !important;
    }

    .hero-reference .hero-visual .hero-image {
        clip-path: polygon(19% 0, 100% 0, 100% 100%, 5% 100%) !important;
        object-position: center 25% !important;
    }

    /* White separator between the left panel and photograph */
    .hero-reference .hero-visual::before {
        content: "" !important;
        display: block !important;
        position: absolute !important;
        z-index: 2 !important;
        inset: 0 auto 0 0 !important;
        width: 24% !important;
        background: #fffdf9 !important;
        clip-path: polygon(68% 0, 83% 0, 20% 100%, 5% 100%) !important;
        pointer-events: none !important;
    }

    /* Cream panel remains on the right */
    .hero-reference .hero-visual::after {
        z-index: 3 !important;
        width: 24% !important;
        background: #fffaf1 !important;
        clip-path: polygon(28% 0, 100% 0, 100% 100%, 0 100%) !important;
    }

    .hero-reference .hero-side-message {
        z-index: 4 !important;
    }
}

/* Layered diagonal geometry — refined reference treatment */
@media (min-width: 992px) {
    .hero-reference .hero-visual {
        isolation: isolate !important;
        overflow: hidden !important;
        background: #fffaf1 !important;
    }

    .hero-reference .hero-visual picture {
        z-index: 1 !important;
        inset: 0 0 0 8% !important;
        width: 92% !important;
    }

    .hero-reference .hero-visual .hero-image {
        clip-path: none !important;
        object-position: center 25% !important;
    }

    /* Multiple diagonal bands: warm cream, white separator, photo edge */
    .hero-reference .hero-visual::before {
        content: "" !important;
        position: absolute !important;
        display: block !important;
        z-index: 2 !important;
        inset: 0 !important;
        width: 100% !important;
        background:
            linear-gradient(
                103deg,
                transparent 0 10.5%,
                #fffdf9 10.5% 13.2%,
                #e8d8bf 13.2% 14.1%,
                #fffaf1 14.1% 16.2%,
                transparent 16.2% 100%
            ) !important;
        clip-path: none !important;
        pointer-events: none !important;
    }

    .hero-reference .hero-visual::after {
        content: "" !important;
        position: absolute !important;
        display: block !important;
        z-index: 3 !important;
        inset: 0 0 0 auto !important;
        width: 24% !important;
        background: #fffaf1 !important;
        clip-path: polygon(28% 0, 100% 0, 100% 100%, 0 100%) !important;
        pointer-events: none !important;
    }

    .hero-reference .hero-side-message {
        z-index: 4 !important;
    }
}

/* Final balance: compact diagonal bands, wider photo */
@media (min-width: 992px) {
    .hero-reference .hero-visual {
        background: #fffaf1 !important;
    }

    .hero-reference .hero-visual picture {
        inset: 0 0 0 0 !important;
        width: 100% !important;
        z-index: 1 !important;
    }

    .hero-reference .hero-visual .hero-image {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
        object-position: center 25% !important;
        clip-path: polygon(17% 0, 100% 0, 100% 100%, 5% 100%) !important;
    }

    .hero-reference .hero-visual::before {
        inset: 0 !important;
        width: 100% !important;
        background: linear-gradient(
            103deg,
            transparent 0 10.5%,
            #fffdf9 10.5% 12.4%,
            #e8d8bf 12.4% 13.1%,
            #fffaf1 13.1% 14.5%,
            transparent 14.5% 100%
        ) !important;
        z-index: 2 !important;
    }

    .hero-reference .hero-visual::after {
        width: 23% !important;
        background: #fffaf1 !important;
        clip-path: polygon(28% 0, 100% 0, 100% 100%, 0 100%) !important;
        z-index: 3 !important;
    }

    .hero-reference .hero-side-message {
        z-index: 4 !important;
    }
}

