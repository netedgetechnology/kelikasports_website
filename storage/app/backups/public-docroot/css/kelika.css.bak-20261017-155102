/* KELIKA reference-match: homepage hero, pass 1 */
.hero-section {
    min-height: 0;
    padding: 0;
    background: var(--kelika-paper);
    isolation: isolate;
}

.hero-section > .container-fluid {
    width: 100%;
    padding-left: clamp(20px, 4.5vw, 68px) !important;
    padding-right: clamp(20px, 4.5vw, 68px) !important;
}

.hero-section .row {
    min-height: 570px;
}

.hero-section .hero-copy {
    position: relative;
    z-index: 2;
    padding: clamp(36px, 5vw, 76px) 24px clamp(36px, 5vw, 76px) 0;
}

.hero-section .eyebrow {
    margin-bottom: 22px;
    font-size: 10px;
    line-height: 1.7;
    letter-spacing: .22em;
    font-weight: 750;
}

.hero-section .display-title {
    margin: 0;
    font-size: clamp(52px, 7.2vw, 100px);
    line-height: .88;
    letter-spacing: -.065em;
    font-weight: 850;
    text-transform: uppercase;
}

.hero-section .display-title span {
    display: inline-block;
}

.hero-section .lead {
    max-width: 390px !important;
    color: var(--kelika-muted);
    font-size: 15px;
    line-height: 1.8;
}

.hero-section .btn-kelika,
.hero-section .btn-kelika-outline {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 13px 19px;
    font-size: 10px;
    letter-spacing: .09em;
}

.hero-section .col-lg-7 {
    align-self: stretch;
    min-width: 0;
}

.hero-section .col-lg-7 picture {
    display: block;
    height: 100%;
    min-height: 570px;
    overflow: hidden;
}

.hero-section .hero-image {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 570px;
    object-fit: cover;
    object-position: center;
    background: #e5ebe5;
}

.hero-section .ornament {
    z-index: -1;
    right: -90px;
    top: 40px;
    width: 260px;
    height: 260px;
    opacity: .2;
}

@media (min-width: 992px) {
    .hero-section .row {
        min-height: 570px;
    }

    .hero-section .col-lg-7 {
        position: relative;
        min-height: 570px;
    }

    .hero-section .col-lg-7 picture {
        position: absolute;
        inset: 0 -4.5vw 0 0;
        min-height: 570px;
    }

    .hero-section .hero-image {
        clip-path: polygon(17% 0, 100% 0, 100% 100%, 0 100%);
        min-height: 570px;
    }
}

@media (max-width: 991.98px) {
    .hero-section .row {
        min-height: 0;
    }

    .hero-section .hero-copy {
        padding: 42px 0 30px;
    }

    .hero-section .display-title {
        font-size: clamp(54px, 11vw, 78px);
        line-height: .9;
    }

    .hero-section .col-lg-7 picture {
        position: relative;
        min-height: 0;
        height: auto;
        margin: 0 -20px;
        width: calc(100% + 40px);
    }

    .hero-section .hero-image {
        height: clamp(270px, 72vw, 440px);
        min-height: 0;
        clip-path: polygon(0 7%, 100% 0, 100% 100%, 0 100%);
        object-position: center;
    }
}

@media (max-width: 575.98px) {
    .hero-section .eyebrow {
        font-size: 9px;
        letter-spacing: .16em;
    }

    .hero-section .display-title {
        font-size: clamp(49px, 14vw, 68px);
    }

    .hero-section .lead {
        font-size: 14px;
    }
}

/* KELIKA hero sizing correction: keep image within the hero */
@media (min-width: 992px) {
    .hero-section .row {
        min-height: 0;
        height: clamp(410px, 38vw, 500px);
    }

    .hero-section .col-lg-7 {
        height: 100%;
        min-height: 0;
    }

    .hero-section .col-lg-7 picture {
        inset: 0 -4.5vw 0 0;
        height: 100%;
        min-height: 0;
    }

    .hero-section .hero-image {
        height: 100%;
        min-height: 0;
        max-height: 500px;
        object-fit: cover;
        object-position: center;
    }

    .hero-section .hero-copy {
        padding-top: 36px;
        padding-bottom: 36px;
    }
}

@media (max-width: 991.98px) {
    .hero-section .col-lg-7 picture {
        height: auto;
        min-height: 0;
    }

    .hero-section .hero-image {
        height: clamp(240px, 58vw, 380px);
        min-height: 0;
        max-height: 380px;
        object-fit: cover;
        object-position: center;
    }
}

/* KELIKA hero: final height constraint */
@media (min-width: 992px) {
    .hero-section {
        height: 460px !important;
        min-height: 0 !important;
        overflow: hidden !important;
        display: block !important;
    }

    .hero-section > .container-fluid {
        height: 100% !important;
    }

    .hero-section .row {
        height: 100% !important;
        min-height: 0 !important;
        max-height: 460px !important;
    }

    .hero-section .hero-copy {
        height: 100% !important;
        padding-top: 38px !important;
        padding-bottom: 28px !important;
    }

    .hero-section .col-lg-7 {
        height: 100% !important;
        min-height: 0 !important;
        max-height: 460px !important;
    }

    .hero-section .col-lg-7 picture {
        position: absolute !important;
        top: 0 !important;
        right: -4.5vw !important;
        bottom: 0 !important;
        left: 0 !important;
        width: auto !important;
        height: 100% !important;
        min-height: 0 !important;
        max-height: 460px !important;
    }

    .hero-section .hero-image {
        width: 100% !important;
        height: 100% !important;
        min-height: 0 !important;
        max-height: 460px !important;
        object-fit: cover !important;
        clip-path: polygon(17% 0, 100% 0, 100% 100%, 0 100%) !important;
    }
}


/* KELIKA reference hero: structured layout, feature icons and side message */
.hero-reference {
    min-height: 0 !important;
    padding: 0 !important;
    background: #fffdf9 !important;
    overflow: hidden;
}
.hero-reference > .container-fluid {
    padding-left: clamp(24px, 4.5vw, 72px) !important;
    padding-right: 0 !important;
}
.hero-reference .row {
    min-height: 500px !important;
    height: auto !important;
}
.hero-reference .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 38px 22px 24px 0 !important;
}
.hero-reference .eyebrow {
    font-size: 10px !important;
    letter-spacing: .2em !important;
    line-height: 1.6;
    margin-bottom: 24px !important;
}
.hero-reference .display-title {
    font-size: clamp(54px, 5.7vw, 88px) !important;
    line-height: .91 !important;
    letter-spacing: -.065em !important;
    font-weight: 900 !important;
    margin: 0 !important;
}
.hero-reference .display-title span {
    display: inline-block;
}
.hero-reference .lead {
    font-size: 14px !important;
    line-height: 1.8 !important;
    max-width: 390px !important;
    margin-top: 22px !important;
    margin-bottom: 24px !important;
    color: #66716c !important;
}
.hero-reference .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}
.hero-reference .hero-actions .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 44px;
    padding: 12px 17px;
    font-size: 10px;
    letter-spacing: .045em;
    white-space: nowrap;
}
.hero-reference .hero-features {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-top: 28px;
    max-width: 620px;
}
.hero-reference .hero-feature {
    display: flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
    color: #26312d;
    font-size: 9px;
    font-weight: 600;
    line-height: 1.35;
}
.hero-reference .hero-feature svg {
    width: 25px;
    height: 25px;
    flex: 0 0 25px;
    fill: none;
    stroke: #344943;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
}
.hero-reference .hero-visual {
    position: relative;
    min-width: 0;
    min-height: 500px;
}
.hero-reference .hero-visual picture {
    position: absolute;
    inset: 0;
    display: block;
    height: 100%;
    overflow: hidden;
}
.hero-reference .hero-visual .hero-image {
    display: block;
    width: 100%;
    height: 100% !important;
    min-height: 0 !important;
    object-fit: cover;
    object-position: center;
    clip-path: polygon(17% 0, 100% 0, 100% 100%, 0 100%);
}
.hero-reference .hero-side-message {
    position: absolute;
    z-index: 2;
    top: 50%;
    right: 3%;
    transform: translateY(-50%);
    width: 115px;
    color: #172522;
    text-align: center;
    pointer-events: none;
}
.hero-reference .hero-side-message > span {
    display: block;
    font-family: Georgia, serif;
    font-size: clamp(24px, 2.2vw, 35px);
    font-style: italic;
    font-weight: 700;
    line-height: .98;
    transform: rotate(-7deg);
    text-shadow: 0 1px 10px rgba(255,253,249,.45);
}
.hero-reference .hero-side-values {
    margin-top: 35px;
    font-size: 9px;
    line-height: 2.3;
    letter-spacing: .15em;
    font-weight: 800;
}
.hero-reference .hero-side-message i {
    display: block;
    width: 28px;
    border-top: 1px solid #d4a35d;
    margin: 12px auto 0;
}
@media (max-width: 1199.98px) and (min-width: 992px) {
    .hero-reference .display-title { font-size: clamp(48px, 5.1vw, 68px) !important; }
    .hero-reference .hero-feature { font-size: 8px; gap: 4px; }
    .hero-reference .hero-feature svg { width: 21px; height: 21px; flex-basis: 21px; }
    .hero-reference .hero-side-message { right: 1%; width: 90px; }
}
@media (max-width: 991.98px) {
    .hero-reference > .container-fluid { padding-right: 24px !important; }
    .hero-reference .row { min-height: 0 !important; }
    .hero-reference .hero-copy { padding: 42px 0 26px !important; }
    .hero-reference .display-title { font-size: clamp(54px, 10vw, 78px) !important; }
    .hero-reference .hero-features { margin-top: 25px; }
    .hero-reference .hero-visual { min-height: 390px; margin: 0 -24px; }
    .hero-reference .hero-visual picture { position: absolute; inset: 0; }
    .hero-reference .hero-visual .hero-image { clip-path: polygon(0 5%,100% 0,100% 100%,0 100%); }
    .hero-reference .hero-side-message { right: 5%; }
}
@media (max-width: 575.98px) {
    .hero-reference .hero-features { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .hero-reference .hero-feature { font-size: 10px; }
    .hero-reference .hero-visual { min-height: 300px; }
    .hero-reference .hero-side-message { width: 80px; right: 2%; }
    .hero-reference .hero-side-message > span { font-size: 24px; }
    .hero-reference .hero-side-values { font-size: 8px; margin-top: 20px; }
}
